# DB
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=reborn

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Azure Storage
AZURE_STORAGE_CONTAINER_NAME=character
# 게임 생성물 업로드 컨테이너 (AI가 layout.json, result.json, background.png 등 올리는 곳). 미설정 시 generated-games
# AZURE_STORAGE_GAMES_CONTAINER_NAME=generated-games
AZURE_STORAGE_CONNECTION_STRING=

# AI (FastAPI). AI_MOCK=true면 외부 AI 없이 더미 동작 (원본→프로필, 프로필→4방향 복사)
AI_BASE_URL=http://localhost:8000
# 게임 생성 전용 URL (404 나오면 AI 서버 실제 경로로 설정. 예: http://localhost:8000/v1/games/generate)
# AI_GAME_GENERATION_URL=

# 콜백 URL 베이스. AI가 백그라운드 완료 시 POST할 주소 = 이 값 + /games/generation-callback
# AI가 Docker 등 다른 프로세스에서 돌면 localhost는 AI 기준이라 Nest에 연결 안 됨.
# → AI가 접근 가능한 주소로 설정: Windows/Mac Docker면 http://host.docker.internal:3001
# GAME_CALLBACK_BASE_URL=http://host.docker.internal:3001

AI_MOCK=true

# Redis (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
